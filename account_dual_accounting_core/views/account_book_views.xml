<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_book_list" model="ir.ui.view">
        <field name="name">account.book.list</field>
        <field name="model">account.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="journal_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_book_form" model="ir.ui.view">
        <field name="name">account.book.form</field>
        <field name="model">account.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Diarios Vinculados">
                        <field name="journal_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="type"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_book" model="ir.actions.act_window">
        <field name="name">Libros Contables</field>
        <field name="res_model">account.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_book"
              name="Libros Contables"
              parent="account.menu_finance_configuration"
              action="action_account_book"
              sequence="15"
              groups="account.group_account_manager"/>

</odoo>
