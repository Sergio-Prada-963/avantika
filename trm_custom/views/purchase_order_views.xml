<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_trm" model="ir.ui.view">
        <field name="name">purchase.order.form.trm</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id'][@force_save='1']" position="after">
                <field name="trm" groups="base.group_multi_currency"/>
            </xpath>
        </field>
    </record>

</odoo>
