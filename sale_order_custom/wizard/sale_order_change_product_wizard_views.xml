<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_change_product_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.change.product.wizard.form</field>
        <field name="model">sale.order.change.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar Producto">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="sale_line_id"/>
                    <field name="current_product_id"/>
                    <field name="new_product_id"/>
                    <field name="keep_price"/>
                </group>
                <footer>
                    <button string="Cambiar Producto" name="action_change_product" type="object"
                        class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_change_product_wizard" model="ir.actions.act_window">
        <field name="name">Cambiar Producto</field>
        <field name="res_model">sale.order.change.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
