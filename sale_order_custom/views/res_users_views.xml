<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_approve_sale_margins" model="ir.ui.view">
        <field name="name">res.users.form.approve.sale.margins</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Preferencias en Ventas">
                    <field name="approve_sale_margins" widget="boolean_toggle"/>
                    <div colspan="2" class="text-muted mb-2">
                        Permite aprobar o rechazar el margen de las líneas de una cotización.
                    </div>
                    <field name="can_edit_price_unit" widget="boolean_toggle"/>
                    <div colspan="2" class="text-muted mb-2">
                        Permite editar manualmente el precio unitario de las líneas de venta.
                    </div>
                    <field name="show_confirm_button_sale" widget="boolean_toggle"/>
                    <div colspan="2" class="text-muted">
                        Muestra los botones de Confirmar y Enviar en las órdenes de venta.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
