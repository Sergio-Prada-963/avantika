<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_wbt" model="ir.ui.view">
        <field name="name">res.partner.property.form.wbt</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="property_account_position_id" position="after">
                <field name="wbt_reteica_agent" groups="account.group_account_user"/>
                <field name="wbt_reteica_tax_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="account.group_account_user"/>
            </field>
        </field>
    </record>
</odoo>
