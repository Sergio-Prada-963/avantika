<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_wbt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wbt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="wbt_uvt_value_setting" string="Bases Mínimas para Retenciones (UVT)"
                         help="Valor en COP de la UVT vigente, usado para calcular la base mínima de las retenciones que tienen activo 'Aplica Base UVT'">
                    <field name="uvt_value"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
