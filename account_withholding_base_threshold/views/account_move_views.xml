<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_wbt" model="ir.ui.view">
        <field name="name">account.move.form.wbt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='fiscal_position_id'])[1]" position="after">
                <field name="city_declaration_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"
                       placeholder="Automática por línea"/>
            </xpath>
        </field>
    </record>
</odoo>
