<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_manual_currency_rate" model="ir.ui.view">
        <field name="name">account.payment.register.form.manual.currency.rate</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <div name="amount_div" position="after">
                <field name="expected_currency_rate" invisible="1"/>
                <div class="d-flex gap-1 text-muted"
                     groups="base.group_multi_currency"
                     invisible="currency_id == company_currency_id">
                    <span>1</span>
                    <field name="company_currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="manual_currency_rate" digits="[12,6]" style="max-width: 21ch;"/>
                    <field name="currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <button type="object" name="refresh_manual_currency_rate" icon="fa-refresh"
                            title="Restablecer la tasa de cambio a la tasa por defecto según la fecha del pago"
                            class="btn btn-link p-0"
                            invisible="manual_currency_rate == expected_currency_rate"/>
                </div>
            </div>
        </field>
    </record>
</odoo>
