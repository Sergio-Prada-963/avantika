<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_manual_currency_rate" model="ir.ui.view">
        <field name="name">sale.order.form.manual.currency.rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="before">
                <field name="company_currency_id" invisible="1"/>
                <field name="expected_currency_rate" invisible="1"/>
                <field name="currency_id" groups="base.group_multi_currency"
                       options="{'no_create': True}"
                       readonly="state in ['cancel', 'sale']"/>
                <label for="currency_rate" string="Tasa de Cambio"
                       groups="base.group_multi_currency"
                       invisible="currency_id == company_currency_id"/>
                <div class="d-flex gap-1 text-muted"
                     groups="base.group_multi_currency"
                     invisible="currency_id == company_currency_id">
                    <span>1</span>
                    <field name="company_currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="currency_rate" digits="[12,6]" readonly="state in ['cancel', 'sale']" style="max-width: 21ch;"/>
                    <field name="currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <button type="object" name="refresh_currency_rate" icon="fa-refresh"
                            title="Restablecer la tasa de cambio a la tasa por defecto según la fecha del pedido"
                            class="btn btn-link p-0"
                            invisible="state in ['cancel', 'sale'] or currency_rate == expected_currency_rate"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
