<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_manual_currency_rate" model="ir.ui.view">
        <field name="name">purchase.order.form.manual.currency.rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="expected_currency_rate" invisible="1"/>
                <field name="show_update_currency_rate_prices" invisible="1"/>
                <div class="d-flex gap-1 text-muted"
                     groups="base.group_multi_currency"
                     invisible="currency_id == company_currency_id">
                    <span>1</span>
                    <field name="company_currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="currency_rate" digits="[12,6]" readonly="state in ['cancel', 'purchase']" style="max-width: 21ch;"/>
                    <field name="currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                    <button type="object" name="refresh_currency_rate" icon="fa-refresh"
                            title="Restablecer la tasa de cambio a la tasa por defecto según la fecha de la orden"
                            class="btn btn-link p-0"
                            invisible="state in ['cancel', 'purchase'] or currency_rate == expected_currency_rate"/>
                </div>
                <button type="object" name="action_update_prices"
                        string="Actualizar Precios"
                        help="Recalcula los precios de todas las líneas según la nueva moneda"
                        class="btn-link mb-1 px-0" icon="fa-refresh"
                        confirm="Esto actualizará el precio unitario de todas las líneas según la nueva moneda."
                        invisible="not show_update_currency_rate_prices or state in ['cancel', 'purchase']"/>
            </field>
        </field>
    </record>
</odoo>
