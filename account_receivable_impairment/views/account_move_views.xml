<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_impairment" model="ir.ui.view">
        <field name="name">account.move.form.impairment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="impairment_calculation_id" invisible="1"/>
                <button name="action_view_impairment_invoices" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not impairment_calculation_id">
                    <field name="impairment_invoice_count" widget="statinfo" string="Facturas"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Deterioro de Cartera" name="impairment_lines"
                      invisible="not impairment_calculation_line_ids">
                    <field name="impairment_calculation_line_ids" readonly="1">
                        <list>
                            <field name="calculation_id"/>
                            <field name="date_maturity"/>
                            <field name="days_overdue"/>
                            <field name="matrix_line_id"/>
                            <field name="residual_amount"/>
                            <field name="percentage" widget="percentage"/>
                            <field name="required_amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
