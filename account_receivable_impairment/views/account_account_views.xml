<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form_impairment" model="ir.ui.view">
        <field name="name">account.account.form.impairment</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="impairment_evaluate" widget="boolean_toggle"
                       invisible="account_type != 'asset_receivable'"/>
            </field>
        </field>
    </record>

</odoo>
