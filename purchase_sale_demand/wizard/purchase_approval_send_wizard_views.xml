<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_approval_send_wizard_form" model="ir.ui.view">
        <field name="name">purchase.approval.send.wizard.form</field>
        <field name="model">purchase.approval.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Aprobación">
                <field name="purchase_order_id" invisible="1"/>
                <group>
                    <field name="partner_id"/>
                    <field name="subject"/>
                </group>
                <field name="body"/>
                <footer>
                    <button string="Enviar" name="action_send" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
