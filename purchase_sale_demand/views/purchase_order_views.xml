<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_sale_demand" model="ir.ui.view">
        <field name="name">purchase.order.form.sale.demand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
                <field name="sale_order_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
