<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_sale_demand" model="ir.ui.view">
        <field name="name">purchase.order.form.sale.demand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
                <field name="sale_line_id" string="Orden de Venta" optional="show"
                    options="{'no_create': True}"
                    domain="[('display_type', '=', False), ('is_downpayment', '=', False),
                             ('order_id.state', '=', 'sale'), ('qty_to_purchase', '&gt;', 0),
                             ('order_id.already_purchased', '=', False),
                             '!', ('move_ids.picking_id.state', '=', 'cancel'),
                             ('product_id', '=', product_id)]"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button string="Cambiar Producto"
                    name="%(action_purchase_order_change_product_wizard)d"
                    type="action"
                    context="{'default_order_id': id}"
                    invisible="state not in ['sent', 'to approve', 'purchase']"/>
                <button string="Cambiar Bodega"
                    name="%(action_purchase_order_change_warehouse_wizard)d"
                    type="action"
                    context="{'default_order_id': id}"
                    invisible="state not in ['draft', 'sent', 'to approve', 'purchase']"/>
            </xpath>
        </field>
    </record>

</odoo>
