<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_line_purchase_demand_list" model="ir.ui.view">
        <field name="name">sale.order.line.purchase.demand.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de Venta por Comprar" editable="bottom" create="false" delete="false">
                <header>
                    <button name="action_create_purchase_orders" type="object"
                            string="Crear Orden(es) de Compra" class="btn-primary"/>
                </header>
                <field name="order_id" readonly="1"/>
                <field name="order_partner_id" string="Cliente" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <widget name="stock_quant_search_widget" options="{'hide_extra_icons': True}"/>
                <field name="exwork" readonly="1"/>
                <field name="price_unit" string="Precio de Venta" readonly="1"/>
                <field name="margin_percent" string="Margen" widget="percentage" readonly="1"/>
                <field name="product_uom_qty" string="Cantidad Pedida" readonly="1"/>
                <field name="location_id" string="Ubicación"/>
                <field name="product_qty_available" string="Cantidad Disponible en Inventario" readonly="1"/>
                <widget name="qty_at_date_widget"/>
                <field name="qty_to_purchase" string="Cantidad a Comprar" readonly="1"/>
                <field name="purchase_proveedor_id" string="Proveedor" readonly="1"/>
                <field name="purchase_currency_id" string="Moneda Proveedor" readonly="1"/>
                <field name="product_uom_id" string="UdM" readonly="1"/>
                <field name="qty_purchased" string="Cantidad Comprada" readonly="1"/>
                <field name="last_purchase_order_state" string="Estado Última Compra" widget="badge" readonly="1"
                    decoration-success="last_purchase_order_state == 'purchase'"
                    decoration-warning="last_purchase_order_state == 'to approve'"
                    decoration-info="last_purchase_order_state in ('draft', 'sent')"
                    decoration-danger="last_purchase_order_state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_purchase_demand_search" model="ir.ui.view">
        <field name="name">sale.order.line.purchase.demand.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Líneas de Venta por Comprar">
                <field name="order_id"/>
                <field name="order_partner_id" string="Cliente"/>
                <field name="product_id"/>
                <field name="purchase_proveedor_id" string="Proveedor"/>
                <filter name="filter_pending_purchase" string="Pendientes por Comprar"
                        domain="[('order_id.state', '=', 'sale'), ('qty_to_purchase', '&gt;', 0),
                                 ('order_id.already_purchased', '=', False),
                                 '!', ('move_ids.picking_id.state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="action_sale_order_line_purchase_demand" model="ir.actions.act_window">
        <field name="name">Líneas de Venta por Comprar</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sale_order_line_purchase_demand_list"/>
        <field name="search_view_id" ref="view_sale_order_line_purchase_demand_search"/>
        <field name="domain">[('display_type', '=', False), ('is_downpayment', '=', False)]</field>
        <field name="context">{'search_default_filter_pending_purchase': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay líneas de venta pendientes por comprar.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_order_line_purchase_demand"
        name="Compra por Demanda"
        parent="purchase.menu_procurement_management"
        action="action_sale_order_line_purchase_demand"
        sequence="7"/>

</odoo>
