<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_schedule_add_lines_form" model="ir.ui.view">
        <field name="name">account.payment.schedule.add.lines.form</field>
        <field name="model">account.payment.schedule.add.lines</field>
        <field name="arch" type="xml">
            <form string="Agregar Facturas">
                <field name="schedule_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="move_ids" nolabel="1" widget="many2many_tags">
                        <list>
                            <field name="partner_id"/>
                            <field name="name" string="Factura"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_residual" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Agregar" name="action_add" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
