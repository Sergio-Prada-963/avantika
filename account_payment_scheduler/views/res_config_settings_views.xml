<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_aps" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting id="aps_payment_scheduler_setting" string="Programación de Pagos a Proveedores"
                    help="Configura la generación automática de programaciones de pago a proveedores">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="aps_payment_journal_id"
                                string="Diario de Pago por Defecto"
                                class="col-lg-4 o_light_label"/>
                            <field name="aps_payment_journal_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="aps_cron_interval_days"
                                string="Frecuencia de Generación (días)"
                                class="col-lg-4 o_light_label"/>
                            <field name="aps_cron_interval_days"/>
                        </div>
                        <div class="row mt8">
                            <label for="aps_due_days_ahead"
                                string="Días de Anticipación antes del Vencimiento"
                                class="col-lg-4 o_light_label"/>
                            <field name="aps_due_days_ahead"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
