<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_inherit_scheduler" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.scheduler</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="payment_schedule_id" readonly="1" invisible="not payment_schedule_id"/>
            </xpath>
        </field>
    </record>

</odoo>
