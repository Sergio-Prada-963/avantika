<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_create_internal_transfer_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.create.internal.transfer.wizard.form</field>
        <field name="model">stock.move.create.internal.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Traer de Otra Bodega">
                <field name="move_ids" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="picking_type_id" domain="[('company_id', 'in', [False, company_id]), ('code', '=', 'internal')]"/>
                </group>
                <footer>
                    <button string="Guardar" name="action_create_internal_transfer" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_move_create_internal_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Traer de Otra Bodega</field>
        <field name="res_model">stock.move.create.internal.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
