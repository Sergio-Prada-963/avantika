<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_aiu" model="ir.ui.view">
        <field name="name">purchase.order.form.aiu</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_aiu_purchase"/>
                <field name="aiu_administracion_percent" widget="percentage" invisible="not is_aiu_purchase"/>
                <field name="aiu_imprevistos_percent" widget="percentage" invisible="not is_aiu_purchase"/>
                <field name="aiu_utilidades_percent" widget="percentage" invisible="not is_aiu_purchase"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list" position="inside">
                <field name="aiu_line_type" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_vendor_response" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.vendor.response</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="vendor_response_status"
                    decoration-info="vendor_response_status == 'sent'"
                    decoration-success="vendor_response_status == 'confirmed'"
                    widget="badge"
                    optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
