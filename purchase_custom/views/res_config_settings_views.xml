<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_aiu_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.form.aiu.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="aiu_purchase_products_setting" string="Compra AIU"
                    help="Productos usados para las líneas de Administración, Imprevistos y Utilidades al activar la Compra AIU">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="aiu_purchase_administracion_product_id" class="col-lg-4 o_light_label" string="Administración"/>
                            <field name="aiu_purchase_administracion_product_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="aiu_purchase_imprevistos_product_id" class="col-lg-4 o_light_label" string="Imprevistos"/>
                            <field name="aiu_purchase_imprevistos_product_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="aiu_purchase_utilidades_product_id" class="col-lg-4 o_light_label" string="Utilidades"/>
                            <field name="aiu_purchase_utilidades_product_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_purchase_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <setting id="po_order_approval" position="after">
                <setting id="purchase_approval_user_setting"
                         help="Usuario que recibirá por correo las órdenes de compra enviadas a aprobación, con un enlace de un clic para confirmarlas">
                    <field name="purchase_approval_user_id"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
