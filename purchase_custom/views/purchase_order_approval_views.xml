<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_approval_by_email" model="ir.ui.view">
        <field name="name">purchase.order.form.approval.by.email</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='bid_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='draft_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='draft_confirm']" position="after">
                <field name="show_confirm_button_no_approval" invisible="1"/>
                <button name="action_confirm_no_approval" type="object"
                        string="Confirmar"
                        invisible="state not in ['draft', 'to approve'] or not show_confirm_button_no_approval"
                        class="oe_highlight" data-hotkey="q"/>
                <button name="action_send_for_approval" type="object"
                        string="Enviar Aprobación"
                        invisible="state != 'draft' or show_confirm_button_no_approval"
                        class="oe_highlight" data-hotkey="v"/>
                <field name="can_approve_purchase" invisible="1"/>
                <button name="action_approve_from_button" type="object"
                        string="Aprobar"
                        invisible="state != 'to approve' or not can_approve_purchase or show_confirm_button_no_approval"
                        class="oe_highlight" data-hotkey="w"/>
            </xpath>
        </field>
    </record>

</odoo>
