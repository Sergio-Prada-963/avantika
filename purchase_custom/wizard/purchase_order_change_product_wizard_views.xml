<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_change_product_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.change.product.wizard.form</field>
        <field name="model">purchase.order.change.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar Producto">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="purchase_line_id"/>
                    <field name="current_product_id"/>
                    <field name="new_product_id"/>
                    <field name="keep_price"/>
                </group>
                <footer>
                    <button string="Cambiar Producto" name="action_change_product"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_change_product_wizard" model="ir.actions.act_window">
        <field name="name">Cambiar Producto</field>
        <field name="res_model">purchase.order.change.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_purchase_order_form_change_product_button" model="ir.ui.view">
        <field name="name">purchase.order.form.change.product.button</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Cambiar Producto"
                    name="%(action_purchase_order_change_product_wizard)d"
                    type="action"
                    context="{'default_order_id': id}"
                    invisible="state not in ['sent', 'to approve', 'purchase']"/>
            </xpath>
        </field>
    </record>

</odoo>
