<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_change_warehouse_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.change.warehouse.wizard.form</field>
        <field name="model">purchase.order.change.warehouse.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar Bodega">
                <field name="order_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="current_picking_type_id"/>
                    <field name="new_picking_type_id"/>
                </group>
                <footer>
                    <button string="Cambiar Bodega" name="action_change_warehouse"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_change_warehouse_wizard" model="ir.actions.act_window">
        <field name="name">Cambiar Bodega</field>
        <field name="res_model">purchase.order.change.warehouse.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_purchase_order_form_change_warehouse_button" model="ir.ui.view">
        <field name="name">purchase.order.form.change.warehouse.button</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Cambiar Bodega"
                    name="%(action_purchase_order_change_warehouse_wizard)d"
                    type="action"
                    context="{'default_order_id': id}"
                    invisible="state not in ['draft', 'sent', 'to approve', 'purchase']"/>
            </xpath>
        </field>
    </record>

</odoo>
