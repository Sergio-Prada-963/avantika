<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_advance_payment_apply_form" model="ir.ui.view">
        <field name="name">account.advance.payment.apply.form</field>
        <field name="model">account.advance.payment.apply</field>
        <field name="arch" type="xml">
            <form string="Aplicar Anticipos">
                <field name="available_advance_line_ids" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="invoice_residual" readonly="1"/>
                </group>
                <field name="move_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="invoice_date"/>
                        <field name="amount_residual"/>
                    </list>
                </field>
                <field name="advance_line_ids" options="{'no_create': True}">
                    <list>
                        <field name="move_id"/>
                        <field name="date"/>
                        <field name="amount_residual"/>
                        <field name="amount_residual_currency"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Aplicar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_advance_payment_apply" model="ir.actions.act_window">
        <field name="name">Aplicar Anticipo</field>
        <field name="res_model">account.advance.payment.apply</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
