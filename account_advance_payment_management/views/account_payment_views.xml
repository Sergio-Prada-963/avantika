<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_apm" model="ir.ui.view">
        <field name="name">account.payment.form.apm</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="apm_is_advance" readonly="state != 'draft'"/>
                <field name="apm_advance_account_id"
                       invisible="not apm_is_advance"
                       required="apm_is_advance"
                       readonly="state != 'draft'"/>
                <field name="apm_residual" invisible="not apm_is_advance"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_apm" model="ir.ui.view">
        <field name="name">account.payment.search.apm</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <filter name="apm_filter_advance_payments" string="Anticipos" domain="[('apm_is_advance', '=', True)]"/>
                <separator/>
            </field>
        </field>
    </record>

    <record id="action_account_payment_apm_customer" model="ir.actions.act_window">
        <field name="name">Anticipos de Clientes</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer', 'default_apm_is_advance': True}</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('apm_is_advance', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra un anticipo de cliente</p>
        </field>
    </record>

    <menuitem action="action_account_payment_apm_customer" id="menu_account_payment_apm_customer"
              parent="account.menu_finance_receivables" sequence="16" groups="account.group_account_user"/>

    <record id="action_account_payment_apm_vendor" model="ir.actions.act_window">
        <field name="name">Anticipos a Proveedores</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier', 'default_apm_is_advance': True}</field>
        <field name="domain">[('partner_type', '=', 'supplier'), ('apm_is_advance', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra un anticipo a proveedor</p>
        </field>
    </record>

    <menuitem action="action_account_payment_apm_vendor" id="menu_account_payment_apm_vendor"
              parent="account.menu_finance_payables" sequence="21" groups="account.group_account_user"/>

</odoo>
