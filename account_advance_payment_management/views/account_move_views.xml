<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_apm_advance_payment" model="ir.ui.view">
        <field name="name">account.move.form.apm.advance.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_apm_advance_payments" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="apm_advance_payment_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="apm_advance_payment_count"/>
                        </span>
                        <span class="o_stat_text">Pago de Anticipo</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
