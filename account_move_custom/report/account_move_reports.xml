<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_custom_invoice" model="report.paperformat">
        <field name="name">Factura Electrónica Personalizada</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_custom_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_custom_invoice"/>
        <field name="name">Factura Electrónica (Personalizada)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_move_custom.report_custom_invoice</field>
        <field name="report_file">account_move_custom.report_custom_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="is_invoice_report">True</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
    </record>

</odoo>
