<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_custom_invoice_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang or doc.company_id.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="dian_document" t-value="doc._l10n_co_dian_get_last_accepted_document()"/>
        <t t-set="dian_values" t-value="doc._l10n_co_dian_get_extra_invoice_report_values() if dian_document else {}"/>
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
            <div class="page" style="font-size:10px;">
                <!-- TODO: seguir armando el diseño definitivo de la factura
                     electrónica. Esto es un punto de partida funcional
                     mientras se termina de definir el resto de la
                     plantilla. -->
                <div class="d-flex align-items-center mb-4" style="width:100%;">
                    <div class="text-center" style="width:25%; box-sizing:border-box; padding-right:6px;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:100px; max-width:100%;" alt="Logo"/>
                    </div>
                    <div style="width:33.3333%; box-sizing:border-box; padding-right:6px;">
                        <strong t-field="company.name"/><br/>
                        <span>NIT: <span t-field="company.vat"/></span><br/>
                        <span t-field="company.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                        <span t-if="company.email">Email: <span t-field="company.email"/><br/></span>
                        <span t-if="company.website">Página web: <span t-field="company.website"/><br/></span>
                        <span t-if="company.phone">Teléfono: <span t-field="company.phone"/></span>
                    </div>
                    <div style="width:25%; box-sizing:border-box; padding-right:6px;">
                        <div>No somos grandes contribuyentes</div>
                        <div>IVA Régimen Común</div>
                        <div>No somos agentes de retención de IVA</div>
                        <div>No somos autoretenedores</div>
                        <div t-if="company.economic_activity_code" class="mt-2">
                            Actividad económica:
                            <span t-field="company.economic_activity_code"/> -
                            <span t-field="company.economic_activity_name"/>
                        </div>
                    </div>
                    <div class="text-center" style="width:16.6667%; box-sizing:border-box;">
                        <div t-if="dian_document">
                            <img t-att-src="dian_values.get('barcode_src')" style="max-width:100%;" alt="QR DIAN"/>
                        </div>
                        <!-- TODO: quitar este QR de ejemplo cuando la factura
                             tenga un documento DIAN aceptado. -->
                        <div t-else="">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="90" height="90">
                                <rect width="100" height="100" fill="white"/>
                                <g fill="black">
                                    <rect x="0" y="0" width="30" height="30"/>
                                    <rect x="8" y="8" width="14" height="14" fill="white"/>
                                    <rect x="70" y="0" width="30" height="30"/>
                                    <rect x="78" y="8" width="14" height="14" fill="white"/>
                                    <rect x="0" y="70" width="30" height="30"/>
                                    <rect x="8" y="78" width="14" height="14" fill="white"/>
                                    <rect x="40" y="10" width="6" height="6"/>
                                    <rect x="50" y="10" width="6" height="6"/>
                                    <rect x="40" y="20" width="6" height="6"/>
                                    <rect x="55" y="40" width="6" height="6"/>
                                    <rect x="45" y="45" width="6" height="6"/>
                                    <rect x="35" y="50" width="6" height="6"/>
                                    <rect x="60" y="55" width="6" height="6"/>
                                    <rect x="40" y="60" width="6" height="6"/>
                                    <rect x="50" y="65" width="6" height="6"/>
                                    <rect x="65" y="35" width="6" height="6"/>
                                    <rect x="35" y="35" width="6" height="6"/>
                                </g>
                            </svg>
                            <div>(QR de ejemplo)</div>
                        </div>
                    </div>
                </div>

                <table class="table table-bordered mt-2" style="table-layout:fixed; width:100%;">
                    <tr>
                        <td style="width:33%;" valign="top">
                            <strong>SEÑORES:</strong> <span t-field="doc.partner_id.vat"/><br/>
                            <span t-field="doc.partner_id.name"/><br/>
                            <span t-field="doc.partner_id.street"/><br/>
                            Tel <span t-field="doc.partner_id.phone"/><br/>
                            <span t-field="doc.partner_id.city"/> - <span t-field="doc.partner_id.state_id.name"/><br/>
                            <span t-field="doc.partner_id.country_id.name"/>
                        </td>
                        <td style="width:33%;" valign="top">
                            <t t-set="shipping_partner" t-value="doc.partner_shipping_id or doc.partner_id"/>
                            <strong>DESPACHADO A:</strong> <span t-field="shipping_partner.vat"/><br/>
                            <span t-field="shipping_partner.street"/><br/>
                            Tel <span t-field="shipping_partner.phone"/><br/>
                            <span t-field="shipping_partner.city"/><br/>
                            <span t-field="shipping_partner.country_id.name"/>
                        </td>
                        <td style="width:34%; padding:0;" valign="top">
                            <table class="table table-bordered mb-0" style="table-layout:fixed; width:100%;">
                                <tr>
                                    <td class="text-center" style="background-color:#e9e9e9;">
                                        <strong>
                                            <span t-if="doc.move_type == 'out_invoice'">FACTURA ELECTRÓNICA DE VENTA</span>
                                            <span t-if="doc.move_type == 'out_refund'">NOTA CRÉDITO ELECTRÓNICA</span>
                                        </strong><br/>
                                        <span t-field="doc.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center"><strong>ORDEN DE COMPRA O CONTRATO</strong><br/><span t-field="doc.ref"/></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><strong>FECHA GENERACIÓN</strong><br/><span t-field="doc.create_date"/></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><strong>FECHA VENCIMIENTO</strong><br/><span t-field="doc.invoice_date_due"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <t t-set="order_lines" t-value="doc.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
                <t t-set="line_taxes" t-value="order_lines.tax_ids"/>

                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th rowspan="2" class="text-center" valign="middle"><strong>REFERENCIA</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>DESCRIPCIÓN</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>MARCA</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>CANTIDAD</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>U/M</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>VALOR UNITARIO</strong></th>
                            <th colspan="2" class="text-center"><strong>IVA</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>VALOR NETO</strong></th>
                            <th rowspan="2" class="text-center" valign="middle"><strong>VALOR TOTAL</strong></th>
                        </tr>
                        <tr>
                            <th class="text-center"><strong>%</strong></th>
                            <th class="text-center"><strong>VALOR</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order_lines" t-as="line">
                            <td><span t-field="line.product_id.default_code"/></td>
                            <td>
                                <span t-esc="line_index + 1"/>.
                                [<span t-field="line.product_id.default_code"/>]
                                <span t-field="line.product_id.name"/>
                            </td>
                            <td class="text-center"><span t-field="line.product_id.l10n_co_edi_brand"/></td>
                            <td class="text-center"><span t-field="line.quantity"/></td>
                            <td class="text-center"><span t-field="line.product_uom_id.name"/></td>
                            <td class="text-end"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                            <td class="text-center">
                                <t t-foreach="line.tax_ids" t-as="tax">
                                    <span t-esc="tax.amount"/><t t-if="not tax_last">, </t>
                                </t>
                            </td>
                            <td class="text-end"><span t-esc="line.price_total - line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            <td class="text-end"><span t-field="line.price_total"/></td>
                        </tr>
                        <tr>
                            <td/>
                            <td>
                                <strong>TRM:</strong>
                                <span t-esc="'%.2f' % (doc.invoice_currency_rate or 1.0)"/>
                                - <span t-field="doc.currency_id.name"/><br/>
                                <strong>TOTAL NRO LINEAS:</strong> <span t-esc="len(order_lines)"/>
                            </td>
                            <td/><td/><td/><td/><td/><td/><td/><td/>
                        </tr>
                    </tbody>
                </table>

                <table class="table table-bordered mb-0">
                    <tr>
                        <td style="width:50%;" valign="top">
                            <strong>OBSERVACIONES:</strong><br/>
                            <span t-field="doc.narration">N/A</span>
                            <div class="mt-2">
                                MEDIO DE PAGO: Instrumento no definido<br/>
                                CONDICIONES DE PAGO: <span t-field="doc.invoice_payment_term_id.name">Contado</span><br/>
                                VALOR LETRAS: <span t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/><br/>
                            </div>
                            <div class="mt-2" style="background-color:#f2f2f2; border:1px solid #ccc; border-radius:4px; padding:6px 10px;">
                                <strong>CONSIGNAR O TRANSFERIR A:</strong><br/>
                                Bancolombia - Cuenta Corriente No. 080-101977-00<br/>
                                A nombre de: AVANTIKA COLOMBIA S.A.S. - NIT 890.101.977-3
                            </div>
                        </td>
                        <td style="width:20%;" class="text-center" valign="top">
                            <strong>TOTAL UNIDADES:</strong>
                            <span t-esc="sum(order_lines.mapped('quantity'))"/>
                        </td>
                        <td style="width:30%; padding:0;" valign="top">
                            <table class="table table-sm mb-0" style="table-layout:fixed; width:100%;">
                                <tr>
                                    <td><strong>SUBTOTAL</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td><strong>DESCUENTO</strong></td>
                                    <td class="text-end"> </td>
                                </tr>
                                <tr>
                                    <tr>
                                        <td><strong>TOTAL IVA</strong></td>
                                        <td class="text-end"><span t-field="doc.amount_tax"/></td>
                                    </tr>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end" style="background-color:#e9e9e9;" valign="middle">
                            <strong>
                                VALOR TOTAL FACTURA <span t-field="doc.currency_id.name"/>:
                                <span t-field="doc.amount_total"/>
                            </strong>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <strong>REMISIÓN:</strong> <span t-field="doc.invoice_origin"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="footer text-center" style="font-size:10px;">
            <div class="mt-1">
                <span t-if="doc.move_type == 'out_invoice'"><strong>REPRESENTACIÓN GRÁFICA DE FACTURA ELECTRÓNICA DE VENTA</strong></span>
                <span t-if="doc.move_type == 'out_refund'"><strong>REPRESENTACIÓN GRÁFICA DE NOTA CRÉDITO ELECTRÓNICA</strong></span>
                <span t-if="doc.journal_id.l10n_co_edi_dian_authorization_number">
                    <strong>RESOLUCIÓN DIAN No. </strong><span t-field="doc.journal_id.l10n_co_edi_dian_authorization_number"/> -
                    <strong>VIGENCIA: DESDE </strong><span t-field="doc.journal_id.l10n_co_edi_dian_authorization_date"/>
                    <strong>HASTA </strong><span t-field="doc.journal_id.l10n_co_edi_dian_authorization_end_date"/> -
                    <strong>NUMERACIÓN: DEL No. </strong><span t-esc="doc.journal_id.code + str(doc.journal_id.l10n_co_edi_min_range_number)"/>
                    <strong>AL </strong><span t-esc="doc.journal_id.code + str(doc.journal_id.l10n_co_edi_max_range_number)"/>
                </span>
                <span t-if="dian_document" style="word-break:break-all;">
                    - <strong><span t-esc="(doc.l10n_co_dian_identifier_type or 'cufe').upper()"/>:</strong>
                    <span t-esc="dian_document.identifier"/>
                </span>
            </div>
            <div class="mt-2">
                PROVEEDOR TECNOLÓGICO: Odoo S.A.S - NIT DE OTRO PAÍS: 222.222.222-2    SOFTWARE: Odoo by Talaltos
            </div>
            <div class="mt-2">
                <strong>PÁGINA <span class="page"/> DE <span class="topage"/></strong>
            </div>
        </div>
    </template>

    <template id="report_custom_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="account_move_custom.report_custom_invoice_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
