<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_custom" model="ir.ui.view">
        <field name="name">res.company.form.inherit.custom</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="economic_activity_code"/>
                <field name="economic_activity_name"/>
                <field name="dian_resolution_number"/>
                <field name="dian_resolution_date_from"/>
                <field name="dian_resolution_date_to"/>
                <field name="dian_resolution_range_from"/>
                <field name="dian_resolution_range_to"/>
                <field name="dian_tech_provider_name"/>
                <field name="dian_tech_provider_vat"/>
                <field name="dian_software_name"/>
            </field>
        </field>
    </record>

</odoo>
