<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_incoterm_id']" position="after">
                <field name="delivery_date"
                    invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="cufe"
                    invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="qr_code" widget="image"
                    invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="dian_validation_date"
                    invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
